    "NSPhotoLibraryUsageDescription": {
      "comment": "Photo library permission purpose string",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a photo to use as your widget background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una foto para usarla como fondo del widget."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una foto para usarla como fondo del widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une photo à utiliser comme arrière-plan du widget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Foto als Widget-Hintergrund."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una foto da usare come sfondo del widget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットの背景に使う写真を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯 배경으로 사용할 사진을 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一张照片用作小组件背景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一張照片作為小工具背景。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma foto para usar como fundo do widget."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma foto para usar como fundo do widget."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите фото для фона виджета."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر صورة لاستخدامها كخلفية للأداة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विजेट बैकग्राउंड के रूप में उपयोग करने के लिए एक फ़ोटो चुनें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een foto als achtergrond voor je widget."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget arka planı olarak kullanmak için bir fotoğraf seçin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz zdjęcie na tło widżetu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett foto att använda som bakgrund till widgeten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et foto, der skal bruges som baggrund til widgetten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse valokuva widgetin taustaksi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et bilde som skal brukes som bakgrunn for widgeten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกรูปเพื่อใช้เป็นพื้นหลังวิดเจ็ต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ảnh để dùng làm nền tiện ích."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih foto untuk digunakan sebagai latar widget."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть фото для фону віджета."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר תמונה לשימוש כרקע ליישומון."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber fotku jako pozadí widgetu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε μια φωτογραφία για φόντο του widget."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon egy fényképet a widget hátteréhez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți o fotografie de folosit ca fundal al widgetului."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih foto untuk digunakan sebagai latar widget."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi fotografiju za pozadinu widgeta."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber fotku ako pozadie widgetu."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria una foto per fer-la servir com a fons del widget."
          }
        }
      }
    }
  }
}
