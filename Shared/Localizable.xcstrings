    "Shared storage is unavailable. Make sure App Groups are enabled for this app.": {
      "comment": "Alert body",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared storage is unavailable. Make sure App Groups are enabled for this app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento compartido no está disponible. Asegúrate de que los App Groups estén activados para esta app."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento compartido no está disponible. Asegúrate de que los App Groups estén activados para esta app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage partagé est indisponible. Vérifiez que les App Groups sont activés pour cette app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemeinsamer Speicher ist nicht verfügbar. Stelle sicher, dass App Groups für diese App aktiviert sind."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiviazione condivisa non disponibile. Assicurati che gli App Groups siano abilitati per questa app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有ストレージを利用できません。このアプリでApp Groupsが有効になっているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 저장 공간을 사용할 수 없습니다. 이 앱에서 App Groups가 활성화되어 있는지 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享存储不可用。请确保已为此 App 启用 App Groups。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享儲存空間無法使用。請確認已為此 App 啟用 App Groups。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento compartilhado está indisponível. Verifique se os App Groups estão ativados para este app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento partilhado está indisponível. Certifique-se de que os App Groups estão ativados para esta app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общее хранилище недоступно. Убедитесь, что App Groups включены для этого приложения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التخزين المشترك غير متاح. تأكد من تفعيل App Groups لهذا التطبيق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साझा संग्रहण उपलब्ध नहीं है। सुनिश्चित करें कि इस ऐप के लिए App Groups चालू हैं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedeelde opslag is niet beschikbaar. Zorg dat App Groups voor deze app zijn ingeschakeld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşılan depolama kullanılamıyor. Bu uygulama için App Groups’un açık olduğundan emin olun."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Magazyn współdzielony jest niedostępny. Upewnij się, że App Groups są włączone dla tej aplikacji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Delad lagring är inte tillgänglig. Kontrollera att App Groups är aktiverade för den här appen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Delt lager er ikke tilgængeligt. Sørg for, at App Groups er slået til for denne app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaettua tallennustilaa ei ole saatavilla. Varmista, että App Groups on käytössä tälle apille."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Delt lagring er utilgjengelig. Sørg for at App Groups er aktivert for denne appen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่เก็บข้อมูลที่ใช้ร่วมกันไม่พร้อมใช้งาน ตรวจสอบว่าเปิด App Groups สำหรับแอปนี้แล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ nhớ dùng chung không khả dụng. Hãy đảm bảo App Groups đã được bật cho ứng dụng này."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyimpanan bersama tidak tersedia. Pastikan App Groups diaktifkan untuk app ini."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спільне сховище недоступне. Переконайтеся, що App Groups увімкнено для цієї програми."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחסון משותף אינו זמין. ודא ש‑App Groups מופעלים עבור היישום הזה."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílené úložiště není k dispozici. Ujisti se, že jsou pro tuto appku zapnuté App Groups."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κοινόχρηστος χώρος αποθήκευσης δεν είναι διαθέσιμος. Βεβαιωθείτε ότι τα App Groups είναι ενεργά για αυτήν την εφαρμογή."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megosztott tárhely nem érhető el. Győződjön meg róla, hogy az App Groups be van kapcsolva az appnál."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Stocarea partajată nu este disponibilă. Asigurați-vă că App Groups sunt activate pentru această aplicație."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Storan dikongsi tidak tersedia. Pastikan App Groups diaktifkan untuk app ini."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zajedničko spremište nije dostupno. Provjeri jesu li App Groups omogućeni za ovu aplikaciju."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdieľané úložisko nie je k dispozícii. Uisti sa, že sú pre túto appku zapnuté App Groups."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’emmagatzematge compartit no està disponible. Assegura’t que els App Groups estan activats per a aquesta app."
          }
        }
      }
    },
