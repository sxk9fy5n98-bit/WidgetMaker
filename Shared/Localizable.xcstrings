    "After saving, your Home Screen widget updates automatically.": {
      "comment": "Footer",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After saving, your Home Screen widget updates automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de guardar, el widget de la pantalla de inicio se actualiza automáticamente."
