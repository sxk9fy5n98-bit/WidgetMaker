    "Photos stay on your device. Tap Save to apply image changes to your Home Screen widget.": {
      "comment": "Image footer",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos stay on your device. Tap Save to apply image changes to your Home Screen widget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos permanecen en tu dispositivo. Toca Guardar para aplicar los cambios de imagen al widget de la pantalla de inicio."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos permanecen en tu dispositivo. Toca Guardar para aplicar los cambios de imagen al widget de la pantalla de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos restent sur votre appareil. Touchez Enregistrer pour appliquer les modifications d’image au widget de l’écran d’accueil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos bleiben auf deinem Gerät. Tippe auf Sichern, um Bildänderungen auf das Widget auf dem Home-Bildschirm anzuwenden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto restano sul dispositivo. Tocca Salva per applicare le modifiche dell’immagine al widget della schermata Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真はこのデバイスにのみ保存されます。ホーム画面のウィジェットに画像の変更を反映するには「保存」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 기기에만 보관됩니다. 홈 화면 위젯에 이미지 변경 사항을 적용하려면 저장을 탭하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片仅保存在你的设备上。点按“存储”以将图像更改应用到主屏幕小组件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片只會保存在你的裝置上。點一下「儲存」以將影像變更套用到主畫面小工具。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos ficam no seu dispositivo. Toque em Salvar para aplicar as alterações de imagem ao widget da Tela de Início."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos ficam no seu dispositivo. Toque em Guardar para aplicar as alterações de imagem ao widget do ecrã principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото остаются на устройстве. Нажмите «Сохранить», чтобы применить изменения изображения к виджету на домашнем экране."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الصور على جهازك. اضغط على حفظ لتطبيق تغييرات الصورة على أداة الشاشة الرئيسية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो आपके डिवाइस पर ही रहती हैं। होम स्क्रीन विजेट पर छवि परिवर्तन लागू करने के लिए सहेजें पर टैप करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto’s blijven op je apparaat. Tik op Bewaar om afbeeldingswijzigingen toe te passen op de widget op het beginscherm."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar cihazınızda kalır. Ana Ekran widget’ına görüntü değişikliklerini uygulamak için Kaydet’e dokunun."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia pozostają na urządzeniu. Stuknij Zapisz, aby zastosować zmiany obrazu do widżetu ekranu początkowego."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Foton stannar på enheten. Tryck på Spara för att tillämpa bildändringar på hemskärmens widget."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos bliver på din enhed. Tryk på Gem for at anvende billedændringer på widgetten på hjemmeskærmen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvat pysyvät laitteessasi. Napauta Tallenna ottaaksesi kuvamuutokset käyttöön Koti-valikon widgetissä."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildene blir på enheten. Trykk på Lagre for å bruke bildeendringer på widgeten på hjem-skjermen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปจะอยู่ในอุปกรณ์ของคุณ แตะบันทึกเพื่อใช้การเปลี่ยนแปลงรูปกับวิดเจ็ตที่หน้าโฮม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh chỉ nằm trên thiết bị. Chạm Lưu để áp dụng thay đổi ảnh cho tiện ích Màn hình chính."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto tetap di perangkat Anda. Ketuk Simpan untuk menerapkan perubahan gambar ke widget Layar Utama."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото залишаються на пристрої. Натисніть «Зберегти», щоб застосувати зміни зображення до віджета на початковому екрані."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונות נשארות במכשיר. הקש על שמור כדי להחיל שינויי תמונה על היישומון במסך הבית."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky zůstanou v zařízení. Klepnutím na Uložit použijete změny obrázku na widget na ploše."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φωτογραφίες παραμένουν στη συσκευή σας. Πατήστε Αποθήκευση για να εφαρμόσετε τις αλλαγές εικόνας στο widget της Αρχικής οθόνης."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fényképek a készüléken maradnak. A Mentés gombbal alkalmazhatja a képváltozásokat a Kezdőképernyő widgetjén."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiile rămân pe dispozitiv. Atingeți Salvează pentru a aplica modificările de imagine pe widgetul de pe ecranul principal."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto kekal pada peranti anda. Ketik Simpan untuk menggunakan perubahan imej pada widget Skrin Utama."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije ostaju na uređaju. Dodirnite Spremi za primjenu promjena slike na widget početnog zaslona."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky zostanú v zariadení. Klepnutím na Uložiť použijete zmeny obrázka na widget na ploche."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fotos romanen al dispositiu. Toca Desa per aplicar els canvis d’imatge al widget de la pantalla d’inici."
          }
        }
      }
    },
