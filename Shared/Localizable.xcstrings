    "Start a Live Activity anytime to pin your design to the Lock Screen.": {
      "comment": "Onboarding detail",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a Live Activity anytime to pin your design to the Lock Screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una Live Activity cuando quieras para fijar tu diseño en la pantalla de bloqueo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una Live Activity cuando quieras para fijar tu diseño en la pantalla de bloqueo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez une Live Activity à tout moment pour épingler votre design à l’écran verrouillé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte jederzeit eine Live Activity, um dein Design auf dem Sperrbildschirm anzuheften."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia una Live Activity in qualsiasi momento per fissare il design sulla schermata di blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでもライブアクティビティを開始して、デザインをロック画面に固定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제든지 라이브 활동을 시작해 디자인을 잠금 화면에 고정하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时开始实时活动，将设计固定到锁定屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時開始實時活動，將設計固定到鎖定畫面。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie uma Live Activity a qualquer momento para fixar seu design na Tela Bloqueada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie uma Live Activity a qualquer momento para fixar o seu design no ecrã bloqueado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускайте Live Activity в любое время, чтобы закрепить дизайн на экране блокировки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ Live Activity في أي وقت لتثبيت تصميمك على شاشة القفل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक स्क्रीन पर डिज़ाइन पिन करने के लिए कभी भी लाइव ऐक्टिविटी शुरू करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start wanneer je wilt een Live Activity om je ontwerp op het toegangsscherm te zetten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasarımınızı Kilit Ekranı’na sabitlemek için istediğiniz zaman bir Live Activity başlatın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom Live Activity w dowolnym momencie, aby przypiąć projekt do ekranu blokady."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Starta en Live Activity när som helst för att fästa din design på låsskärmen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Start en Live Activity når som helst for at fastgøre dit design på låseskærmen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnistä Live Activity milloin tahansa kiinnittääksesi suunnittelusi lukitusnäyttöön."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Start en Live Activity når som helst for å feste designet på låseskjermen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่ม Live Activity ได้ทุกเมื่อเพื่อปักหมุดดีไซน์ไว้ที่หน้าล็อก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu Live Activity bất cứ lúc nào để ghim thiết kế lên Màn hình khóa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai Live Activity kapan saja untuk menyematkan desain ke Layar Terkunci."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускайте Live Activity будь-коли, щоб закріпити дизайн на екрані блокування."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחל Live Activity בכל עת כדי לנעוץ את העיצוב במסך הנעילה."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spusť Live Activity kdykoli a připni svůj návrh na zamykací obrazovku."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινήστε μια Live Activity οποιαδήποτε στιγμή για να καρφιτσώσετε το σχέδιό σας στην οθόνη κλειδώματος."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Indítson bármikor Live Activityt, hogy a dizájnt a Zárolási képernyőre rögzítse."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
