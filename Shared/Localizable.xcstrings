          "stringUnit": {
            "state": "translated",
            "value": "デザインを保存し、ホーム画面のウィジェットを更新します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디자인을 저장하고 홈 화면 위젯을 새로 고칩니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
