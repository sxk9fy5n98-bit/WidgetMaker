    "Long-press your Home Screen, tap Edit, then Add Widget.": {
      "comment": "Onboarding detail",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-press your Home Screen, tap Edit, then Add Widget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la pantalla de inicio, toca Editar y luego Añadir widget."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén presionada la pantalla de inicio, toca Editar y luego Agregar widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez longuement sur l’écran d’accueil, touchez Modifier, puis Ajouter un widget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe und halte den Home-Bildschirm, tippe auf Bearbeiten und dann auf Widget hinzufügen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta la schermata Home, tocca Modifica, poi Aggiungi widget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面を長押しし、「編集」から「ウィジェットを追加」をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면을 길게 누른 다음 편집을 탭하고 위젯 추가를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按主屏幕，点按“编辑”，然后点按“添加小组件”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按主畫面，點一下「編輯」，然後點一下「加入小工具」。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure a Tela de Início, toque em Editar e depois em Adicionar Widget."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e mantenha o ecrã principal, toque em Editar e depois em Adicionar Widget."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте домашний экран, нажмите «Изменить», затем «Добавить виджет»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على الشاشة الرئيسية، ثم اضغط على تعديل، ثم إضافة أداة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होम स्क्रीन को देर तक दबाएँ, संपादित करें टैप करें, फिर विजेट जोड़ें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd het beginscherm ingedrukt, tik op Wijzig en daarna op Voeg widget toe."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana Ekran’a basılı tutun, Düzenle’ye, ardından Widget Ekle’ye dokunun."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj ekran początkowy, stuknij Edytuj, a następnie Dodaj widżet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck och håll på hemskärmen, tryck på Redigera och sedan på Lägg till widget."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk og hold på hjemmeskærmen, tryk på Rediger og derefter på Tilføj widget."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina pitkään Koti-valikkoa, napauta Muokkaa ja sitten Lisää widget."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk og hold på hjem-skjermen, trykk på Rediger og deretter på Legg til widget."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดค้างที่หน้าโฮม แตะแก้ไข แล้วแตะเพิ่มวิดเจ็ต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn giữ Màn hình chính, chạm Sửa, rồi Thêm tiện ích."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan lama Layar Utama, ketuk Edit, lalu Tambah Widget."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть і утримуйте початковий екран, натисніть «Змінити», потім «Додати віджет»."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחץ לחיצה ארוכה על מסך הבית, הקש על ״עריכה״ ואז על ״הוסף יישומון״."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlouze stiskni plochu, klepni na Upravit a pak na Přidat widget."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε παρατεταμένα την Αρχική οθόνη, πατήστε Επεξεργασία και μετά Προσθήκη widget."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomja hosszan a Kezdőképernyőt, koppintson a Szerkesztés, majd a Widget hozzáadása elemre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țineți apăsat pe ecranul principal, atingeți Editați, apoi Adăugați widget."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan lama Skrin Utama, ketik Edit, kemudian Tambah Widget."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dugo pritisni početni zaslon, dodirni Uredi, zatim Dodaj widget."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlhým stlačením plochy klepni na Upraviť a potom na Pridať widget."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén premuda la pantalla d’inici, toca Edita i després Afegeix un widget."
          }
        }
      }
    },
