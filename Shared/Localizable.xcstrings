    "Customize your design in this app, then tap Save.": {
      "comment": "Help step 1",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customize your design in this app, then tap Save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Personaliza tu diseño en esta app y luego toca Guardar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Personaliza tu diseño en esta app y luego toca Guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personnalisez votre design dans cette app, puis touchez Enregistrer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe dein Design in dieser App an und tippe dann auf Sichern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalizza il design in questa app, poi tocca Salva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリでデザインをカスタマイズし、「保存」をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱에서 디자인을 사용자화한 다음 저장을 탭하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 App 中自定设计，然后点按“存储”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 App 中自訂設計，然後點一下「儲存」。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalize seu design neste app e toque em Salvar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalize o seu design nesta app e toque em Guardar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте дизайн в этом приложении и нажмите «Сохранить»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خصّص تصميمك في هذا التطبيق ثم اضغط على حفظ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस ऐप में अपना डिज़ाइन कस्टमाइज़ करें, फिर सहेजें पर टैप करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas je ontwerp aan in deze app en tik daarna op Bewaar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamada tasarımınızı özelleştirin, ardından Kaydet’e dokunun."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosuj projekt w tej aplikacji, a następnie stuknij Zapisz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anpassa din design i den här appen och tryck sedan på Spara."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpas dit design i denne app, og tryk derefter på Gem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukauta suunnitteluasi tässä apissa ja napauta sitten Tallenna."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpass designet i denne appen, og trykk deretter på Lagre."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับแต่งดีไซน์ในแอปนี้ แล้วแตะบันทึก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chỉnh thiết kế trong ứng dụng này, rồi chạm Lưu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan desain Anda di app ini, lalu ketuk Simpan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте дизайн у цій програмі, потім натисніть «Зберегти»."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התאם אישית את העיצוב ביישום זה ולאחר מכן הקש על שמור."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přizpůsob si návrh v této appce a pak klepni na Uložit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσαρμόστε το σχέδιό σας σε αυτήν την εφαρμογή και πατήστε Αποθήκευση."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Testreszabja a dizájnt ebben az appban, majd koppintson a Mentés gombra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalizați designul în această aplicație, apoi atingeți Salvează."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan reka bentuk anda dalam app ini, kemudian ketik Simpan."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilagodi dizajn u ovoj aplikaciji, zatim dodirni Spremi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prispôsob si návrh v tejto appke a potom klepni na Uložiť."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalitza el disseny en aquesta app i després toca Desa."
          }
        }
      }
    },
    "On your Home Screen, touch and hold an empty area until the apps jiggle.": {
      "comment": "Help step 2",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your Home Screen, touch and hold an empty area until the apps jiggle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la pantalla de inicio, mantén pulsada un área vacía hasta que las apps tiemblen."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "En la pantalla de inicio, mantén presionada un área vacía hasta que las apps tiemblen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l’écran d’accueil, touchez et maintenez une zone vide jusqu’à ce que les apps bougent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe und halte auf dem Home-Bildschirm eine leere Stelle, bis die Apps wackeln."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella schermata Home, tieni premuta un’area vuota finché le app non tremano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面の空きスペースを長押しして、アプリが震えるまで待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면의 빈 영역을 앱이 흔들릴 때까지 길게 누르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在主屏幕上按住空白区域，直到 App 开始抖动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在主畫面上長按空白區域，直到 App 開始晃動。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na Tela de Início, toque e segure uma área vazia até os apps tremerem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "No ecrã principal, toque e mantenha uma área vazia até as apps tremerem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На домашнем экране нажмите и удерживайте пустую область, пока приложения не начнут покачиваться."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على الشاشة الرئيسية، اضغط مطولًا على مساحة فارغة حتى تهتز التطبيقات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होम स्क्रीन पर खाली जगह को देर तक दबाए रखें जब तक ऐप काँपने न लगें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd op het beginscherm een leeg gebied ingedrukt tot de apps wiebelen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana Ekran’da boş bir alana uygulamalar titreyene kadar basılı tutun."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ekranie początkowym przytrzymaj puste miejsce, aż aplikacje zaczną się trząść."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck och håll på ett tomt område på hemskärmen tills apparna skakar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk og hold på et tomt område på hjemmeskærmen, indtil appsene begynder at vippe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina pitkään tyhjää kohtaa Koti-valikossa, kunnes apit alkavat heilua."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk og hold på et tomt område på hjem-skjermen til appene begynner å vippe."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่หน้าโฮม กดค้างที่พื้นที่ว่างจนกว่าแอปจะสั่น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên Màn hình chính, nhấn giữ vùng trống cho đến khi các app rung."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di Layar Utama, tekan lama area kosong hingga app bergoyang."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На початковому екрані натисніть і утримуйте порожню ділянку, доки програми не почнуть тремтіти."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במסך הבית, לחץ לחיצה ארוכה על אזור ריק עד שהיישומים רועדים."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ploše dlouze stiskni prázdné místo, dokud apky nezačnou vibrovat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στην Αρχική οθόνη, πατήστε παρατεταμένα μια κενή περιοχή μέχρι να κουνηθούν οι εφαρμογές."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kezdőképernyőn nyomjon hosszan egy üres területet, amíg az appok rázkódni nem kezdenek."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe ecranul principal, țineți apăsat pe o zonă goală până când aplicațiile tremură."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada Skrin Utama, tekan lama kawasan kosong sehingga app bergegar."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na početnom zaslonu dugo pritisni prazno područje dok se aplikacije ne zatresu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ploche dlhým stlačením prázdneho miesta počkaj, kým sa apky nezačnú trasť."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A la pantalla d’inici, mantén premuda una àrea buida fins que les apps tremolin."
          }
        }
      }
    },
    "Tap Edit in the corner, then Add Widget.": {
