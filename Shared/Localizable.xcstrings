            "state": "translated",
            "value": "Concevez une fois. Voyez-le partout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal gestalten. Überall sehen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Progetta una volta. Vedi ovunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度デザインすれば、どこでも表示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 디자인하고, 어디서나 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次设计，随处可见。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次設計，隨處可見。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma vez. Veja em todo lugar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe uma vez. Veja em todo o lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте один раз — смотрите везде."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صمّم مرة واحدة وشاهده في كل مكان."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार डिज़ाइन करें। हर जगह देखें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontwerp één keer. Zie het overal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez tasarla. Her yerde gör."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaprojektuj raz. Zobacz wszędzie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Designa en gång. Se det överallt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Design én gang. Se det overalt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suunnittele kerran. Näe kaikkialla."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Design én gang. Se det overalt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกแบบครั้งเดียว เห็นได้ทุกที่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết kế một lần. Xem mọi nơi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Desain sekali. Lihat di mana saja."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть один раз — бачте всюди."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עצבו פעם אחת. ראו בכל מקום."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navrhni jednou. Uvidíš všude."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχεδιάστε μία φορά. Δείτε το παντού."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tervezze meg egyszer. Lássa mindenütt."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Proiectați o dată. Vedeți peste tot."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Reka bentuk sekali. Lihat di mana-mana."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dizajniraj jednom. Vidi svugdje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Navrhni raz. Uvidíš všade."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Dissenya un cop. Ves-ho a tot arreu."
          }
        }
      }
    },
