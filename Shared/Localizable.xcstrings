    "Dynamic Island and Lock Screen are showing your widget.": {
      "comment": "LA active",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island and Lock Screen are showing your widget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island y la pantalla de bloqueo muestran tu widget."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island y la pantalla de bloqueo muestran tu widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island et l’écran verrouillé affichent votre widget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island und der Sperrbildschirm zeigen dein Widget."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island e la schermata di blocco mostrano il tuo widget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Islandとロック画面にウィジェットが表示されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island과 잠금 화면에 위젯이 표시되고 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
