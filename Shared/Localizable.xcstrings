    "Your custom title, colors, font, progress, and background on the Home Screen.": {
      "comment": "Widget description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your custom title, colors, font, progress, and background on the Home Screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu título, colores, fuente, progreso y fondo personalizados en la pantalla de inicio."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu título, colores, fuente, progreso y fondo personalizados en la pantalla de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre titre, couleurs, police, progression et arrière-plan personnalisés sur l’écran d’accueil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein eigener Titel, Farben, Schrift, Fortschritt und Hintergrund auf dem Home-Bildschirm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo titolo, colori, font, avanzamento e sfondo personalizzati sulla schermata Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面にカスタムのタイトル、色、フォント、進捗、背景を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면에 맞춤 제목, 색상, 서체, 진행률, 배경을 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在主屏幕上显示你的自定标题、颜色、字体、进度和背景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在主畫面上顯示你的自訂標題、顏色、字體、進度和背景。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu título, cores, fonte, progresso e fundo personalizados na Tela de Início."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu título, cores, tipo de letra, progresso e fundo personalizados no ecrã principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши заголовок, цвета, шрифт, прогресс и фон на домашнем экране."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوانك وألوانك وخطك وتقدمك وخلفيتك المخصصة على الشاشة الرئيسية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होम स्क्रीन पर आपका कस्टम शीर्षक, रंग, फ़ॉन्ट, प्रगति और बैकग्राउंड।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eigen titel, kleuren, lettertype, voortgang en achtergrond op het beginscherm."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana Ekran’da özel başlık, renkler, yazı tipi, ilerleme ve arka planınız."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój własny tytuł, kolory, czcionka, postęp i tło na ekranie początkowym."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din egna rubrik, färger, typsnitt, förlopp och bakgrund på hemskärmen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din egen titel, farver, skrifttype, status og baggrund på hjemmeskærmen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oma otsikko, värit, fontti, edistyminen ja tausta Koti-valikossa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Din egen tittel, farger, skrift, fremdrift og bakgrunn på hjem-skjermen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อ สี แบบอักษร ความคืบหน้า และพื้นหลังที่คุณกำหนดบนหน้าโฮม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiêu đề, màu, phông chữ, tiến độ và nền tùy chỉnh trên Màn hình chính."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Judul, warna, font, progres, dan latar kustom Anda di Layar Utama."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш власний заголовок, кольори, шрифт, прогрес і тло на початковому екрані."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכותרת, הצבעים, הגופן, ההתקדמות והרקע המותאמים שלך במסך הבית."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastní název, barvy, písmo, průběh a pozadí na ploše."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο προσαρμοσμένος τίτλος, τα χρώματα, η γραμματοσειρά, η πρόοδος και το φόντο σας στην Αρχική οθόνη."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyéni cím, színek, betűtípus, folyamat és háttér a Kezdőképernyőn."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Titlul, culorile, fontul, progresul și fundalul dvs. personalizate pe ecranul principal."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tajuk, warna, fon, kemajuan dan latar tersuai anda pada Skrin Utama."
          }
