    "Design once. See it everywhere.": {
      "comment": "Onboarding headline",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Design once. See it everywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diseña una vez. Véalo en todas partes."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Diseña una vez. Véalo en todas partes."
          }
        },
        "fr": {
