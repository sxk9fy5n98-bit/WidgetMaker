    "Saves your design and refreshes Home Screen widgets": {
      "comment": "Save hint",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves your design and refreshes Home Screen widgets"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tu diseño y actualiza los widgets de la pantalla de inicio"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tu diseño y actualiza los widgets de la pantalla de inicio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre votre design et actualise les widgets de l’écran d’accueil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert dein Design und aktualisiert die Widgets auf dem Home-Bildschirm"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva il design e aggiorna i widget della schermata Home"
          }
        },
